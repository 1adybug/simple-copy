{
  "name": "simple-copy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm dev:website",
    "dev:desktop": "pnpm --filter @simple-copy/desktop tauri dev",
    "dev:website": "pnpm --filter @simple-copy/website dev",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r --if-present build",
    "build:desktop": "pnpm --filter @simple-copy/desktop build",
    "build:website": "pnpm --filter @simple-copy/website build",
    "build:installer": "pnpm --filter @simple-copy/desktop tauri build --bundles nsis",
    "package:website": "node scripts/package-website.mjs",
    "preview:website": "pnpm --filter @simple-copy/website preview",
    "check:rust": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --all --check && cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml --lib",
    "tauri": "pnpm --filter @simple-copy/desktop tauri"
  }
}
